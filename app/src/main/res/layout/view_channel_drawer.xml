<?xml version="1.0" encoding="utf-8"?>
<!-- 多屏右侧滑出频道抽屉（spec §6）：与 view_epg_panel 同构，两列=分组|频道 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerPanel"
    android:layout_width="520dp" android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="#F20B0E17"
    android:padding="20dp"
    android:elevation="8dp"
    android:visibility="gone">
    <TextView android:id="@+id/drawerTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginBottom="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/drawerGroupList"
            android:layout_width="150dp" android:layout_height="match_parent" android:focusable="false" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/drawerChannelList"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:focusable="false" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="返回键关闭" android:textColor="#667788" android:textSize="13sp"
        android:gravity="end" android:layout_marginTop="8dp" />
</LinearLayout>
