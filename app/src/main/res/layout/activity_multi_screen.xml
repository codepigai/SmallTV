<?xml version="1.0" encoding="utf-8"?>
<!-- 多屏观看主页（spec 2026-11-11 §5）：信息条 + 网格容器 + 布局选择 overlay + 频道抽屉 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/multiInfoBar"
            android:layout_width="match_parent" android:layout_height="32dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:background="#CC000000">
            <TextView android:id="@+id/multiModeText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#8899BB" android:textSize="12sp" />
            <TextView android:id="@+id/multiSelText" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:textColor="#8899BB" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/multiAudioText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#8899BB" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout android:id="@+id/gridContainer"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- 布局选择层：每次进入 Activity 都弹（spec §3.2/§13） -->
    <LinearLayout android:id="@+id/pickerOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:background="#CC000000" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="多屏观看" android:textColor="#FFFFFF" android:textSize="26sp"
            android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="选择屏幕布局，选好后点格内确定选频道" android:textColor="#8899BB" android:textSize="14sp"
            android:layout_marginBottom="24dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/pickerTwo" style="@style/CtrlBtn" android:text="2 屏" />
            <TextView android:id="@+id/pickerFour" style="@style/CtrlBtn" android:text="4 屏"
                android:layout_marginStart="16dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="长按返回键退出多屏" android:textColor="#667788" android:textSize="13sp"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <include layout="@layout/view_channel_drawer" />
</FrameLayout>
