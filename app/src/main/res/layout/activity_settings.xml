<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:id="@+id/rowMode"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:background="@drawable/focus_bg"
        android:focusable="true" android:clickable="true" android:padding="14dp"
        android:textSize="18sp" android:textColor="#FFFFFF" />

    <TextView android:id="@+id/rowSpan"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:background="@drawable/focus_bg"
        android:focusable="true" android:clickable="true" android:padding="14dp"
        android:textSize="18sp" android:textColor="#FFFFFF" />

    <TextView android:id="@+id/rowVersion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="14sp" android:textColor="#8899BB" />
</LinearLayout>
