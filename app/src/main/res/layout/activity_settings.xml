<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页两栏（spec 2026-11-12-ui-visual §⑥ 参考 config.png）：左大 logo，右「通用」分组卡片行；行=图标+名称+值+箭头 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="32dp">

    <ImageView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_gravity="center_vertical"
        android:src="@drawable/app_logo" android:adjustViewBounds="true" android:maxWidth="420dp" />

    <LinearLayout android:layout_width="480dp" android:layout_height="match_parent"
        android:layout_marginStart="32dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="设置" android:textSize="24sp" android:textColor="#FFFFFF" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="通用" android:textSize="13sp" android:textColor="#8899BB" android:layout_marginBottom="8dp" />

        <LinearLayout android:id="@+id/rowMode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/setting_row"
            android:padding="16dp" android:layout_marginBottom="14dp" android:gravity="center_vertical"
            android:focusable="true" android:clickable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_display" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="显示方式" android:textSize="17sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/rowModeValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="#8899BB" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="›" android:textSize="18sp" android:textColor="#667788" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowSpan"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/setting_row"
            android:padding="16dp" android:layout_marginBottom="14dp" android:gravity="center_vertical"
            android:focusable="true" android:clickable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_tab_grid" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="宫格路数" android:textSize="17sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/rowSpanValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="#8899BB" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="›" android:textSize="18sp" android:textColor="#667788" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowVersion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/setting_row"
            android:padding="16dp" android:gravity="center_vertical"
            android:focusable="false" android:clickable="false">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_info" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="版本" android:textSize="17sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/rowVersionValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="#8899BB" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
