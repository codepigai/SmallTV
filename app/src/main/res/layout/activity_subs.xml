<?xml version="1.0" encoding="utf-8"?>
<!-- 订阅管理双栏（spec 2026-11-11-ui-batch §④ 草图A）：左=订阅卡片列表，右=详情+操作；焦点左右列互切走框架默认 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="32dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="订阅管理" android:textSize="24sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/btnAdd" style="@style/CtrlBtn" android:text="＋ 添加订阅" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/subList"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="24dp" android:orientation="vertical">
            <!-- 详情卡（spec 2026-11-12-ui-visual §⑤）：#202A55 圆角卡与下方按钮同列左对齐（按钮 marginStart 归零） -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:padding="16dp" android:layout_marginBottom="16dp">
                <TextView android:id="@+id/subInfoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="订阅信息" android:textSize="12sp" android:textColor="#8899BB" />
                <TextView android:id="@+id/subRowName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/subRowUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#DDDDDD"
                    android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/subRowMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#DDDDDD" />
                <TextView android:id="@+id/subRowEpg" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#DDDDDD" />
            </LinearLayout>
            <TextView android:id="@+id/btnCurrent" style="@style/CtrlBtn" android:text="设为当前" android:layout_marginStart="0dp" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/btnRefresh" style="@style/CtrlBtn" android:text="刷新订阅" android:layout_marginStart="0dp" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/btnEdit" style="@style/CtrlBtn" android:text="编辑" android:layout_marginStart="0dp" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/btnDelete" style="@style/CtrlBtn" android:text="删除" android:layout_marginStart="0dp" android:layout_marginTop="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
